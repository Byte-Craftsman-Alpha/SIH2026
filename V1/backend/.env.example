# =========================================================================
# MediKiosk Backend Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# =========================================================================

# Application Environment Mode: 'beta' (local SQLite) or 'normal' / 'production' (Supabase)
ENVIRONMENT=beta

# Port & Host configuration
HOST=0.0.0.0
PORT=8000

# Secret Key for JWT Token Generation (generate a random 256-bit key in production)
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini / Vision API Key (Optional for live multimodal OCR)
GOOGLE_API_KEY=your_google_api_key_here

# -------------------------------------------------------------------------
# Supabase Cloud Configuration (Required for 'normal' / production mode)
# Found in your Supabase Project Settings -> API & Database
# -------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
ANON_KEY=your_supabase_anon_public_key
SERVICE_ROLE=your_supabase_service_role_key

# Supabase Storage Bucket for medical documents and prescriptions
SUPABASE_BUCKET=medical-records

# PostgreSQL Direct Connection URL (pooled connection recommended for Vercel serverless)
# Example: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres


# ── Bhashini ─────────────────────────────────────────
BHASHINI_USER_ID=""
BHASHINI_ULCA_API_KEY=""
BHASHINI_ASR_PIPELINE_ID=""
BHASHINI_TTS_PIPELINE_ID=""

# ── ABDM Sandbox ─────────────────────────────────────
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_BASE_URL="https://dev.abdm.gov.in/api/hiecm"
ABHA_BASE_URL="https://abhasbx.abdm.gov.in/abha/api"
ABDM_CM_ID="sbx"
ABHA_MOCK_MODE="false"

# ── HIS Push ─────────────────────────────────────────
HIS_PUSH_URL=""
HIS_PUSH_TIMEOUT_SECONDS="15"
